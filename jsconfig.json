{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.js", "src/**/*.d.ts", "tests/**/*.js"]
}
