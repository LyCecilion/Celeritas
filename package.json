{
    "name": "celeritas",
    "version": "0.1.0",
    "description": "On the Roche Limit.",
    "author": "LyCecilion",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/LyCecilion/Celeritas.git"
    },
    "bugs": {
        "url": "https://github.com/LyCecilion/Celeritas/issues"
    },
    "homepage": "https://github.com/LyCecilion/Celeritas",
    "keywords": [
        "userscript",
        "tampermonkey",
        "course-selection",
        "automation"
    ],
    "packageManager": "pnpm@11.22.0",
    "type": "module",
    "scripts": {
        "build": "node scripts/build.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc -p jsconfig.json --noEmit",
        "lint": "eslint src tests scripts",
        "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.mjs\" package.json jsconfig.json",
        "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.mjs\" package.json jsconfig.json",
        "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
        "check:artifact": "npm run build && git diff --exit-code -- celeritas.user.js"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "esbuild": "^0.25.0",
        "eslint": "^9.0.0",
        "globals": "^16.0.0",
        "prettier": "^3.0.0",
        "typescript": "^5.0.0",
        "vitest": "^3.0.0"
    }
}
